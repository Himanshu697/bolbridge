{
  "python.defaultInterpreterPath": "${workspaceFolder}/server/.venv",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/server",
  "python.testing.pytestArgs": ["tests"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "editor.formatOnSave": false,
  "[python]": { "editor.tabSize": 4 },
  "[javascript][javascriptreact][json][css]": { "editor.tabSize": 2 }
}
