# Copy this file to server/.env and change what you need.

APP_ENV=development
# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Web app address(es) allowed to call the API
CORS_ORIGINS=http://localhost:3000
# true while developing: the extension works without logging in (no minutes are counted)
ALLOW_ANONYMOUS_WS=true
# true while developing: allows switching plans without payment
DEV_MODE=true

# ---------- Engines ----------
# mock        = no models, instant fake translations (to test the whole system)
# open-source = Whisper + M2M100 + Kokoro (install requirements-ml.txt first)
ENGINE_PRESET=mock

# Override single engines if you want:
# ASR_ENGINE=whisper          # whisper | mock
# WHISPER_MODEL=small         # tiny | base | small | medium | large-v3 | turbo
# WHISPER_DEVICE=auto         # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=auto   # auto | int8 | float16
# Hindi speech-to-text: AI4Bharat IndicConformer hears Hindi better than Whisper
# small and is several times faster on a CPU. Other languages still use Whisper.
# HINDI_ASR=indicconformer    # whisper | indicconformer
# INDIC_ASR_MODEL=OpenVoiceOS/ai4bharat-indicconformer-hi-onnx
# INDIC_ASR_QUANTIZATION=int8 # int8 (faster) | empty for full precision
# English, French, Spanish, Italian, Portuguese, German, Russian: NVIDIA Parakeet v3
# (CC-BY-4.0, credit NVIDIA). Much faster than Whisper on a CPU.
# EUROPEAN_ASR=parakeet       # whisper | parakeet
# Translator in CTranslate2 int8 (default for open-source): smaller and faster
# M2M_CT2_MODEL=jncraton/m2m100_418M-ct2-int8
# Threads per model (0 = one per physical CPU core) and voices to load at start
# CPU_THREADS=0
# WARMUP_LANGS=hi,en
# MT_ENGINE=m2m100-ct2        # m2m100-ct2 | m2m100 | ollama | mock
# M2M_MODEL=facebook/m2m100_418M
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# TTS_ENGINE=kokoro           # kokoro | mock

# Speak in the user's own voice (optional, needs voice-clone-service running)
# VOICE_ENGINE=openvoice-service
# VOICE_SERVICE_URL=http://localhost:8100

# ---------- Turn-taking ----------
# How long a pause (ms) ends a sentence. Lower = faster, but may cut people off.
VAD_END_SILENCE_MS=600
VAD_MAX_UTTERANCE_S=12
VAD_THRESHOLD_DB=-45
